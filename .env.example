# BravoPay — NÃO commite sua chave real
# Copie para .env.local e cole sua chave de https://bravopay.club/dashboard/api-keys
# VERCEL: Settings > Environment Variables > BRAVOPAY_API_KEY em Production + Preview + Development + Redeploy
BRAVOPAY_API_KEY=bp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: se BravoPay exigir header de assinatura de webhook, configure aqui
# BRAVOPAY_WEBHOOK_SECRET=whsec_xxx

# Painel admin rastreio/clientes/pedidos
ADMIN_PASSWORD=admin123
NEXT_PUBLIC_BASE_URL=http://localhost:3000
RESEND_API_KEY=

# Criptografia de dados sensíveis (LGPD) — gere com: openssl rand -base64 32
# Se vazio, usa hash da BRAVOPAY_API_KEY (menos seguro, trocar em prod)
CUSTOMER_ENCRYPTION_KEY=

# Webhooks / CRM — conecte ActiveCampaign, RD Station, Utmify, Z-API, etc.
# Pode definir uma ou várias URLs separadas por vírgula, ou por variável dedicada
WEBHOOK_URL=
WEBHOOK_URLS=
WEBHOOK_CUSTOMER_URL=
WEBHOOK_ORDER_URL=
WEBHOOK_SECRET=
ACTIVECAMPAIGN_WEBHOOK_URL=
RDSTATION_WEBHOOK_URL=
UTMIFY_WEBHOOK_URL=

